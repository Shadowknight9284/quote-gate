# Copy to docs/private/tiger.env (chmod 600). Parsed as KEY=VALUE by quote_gate.importer;
# never sourced by a shell. No interpolation, escapes or command substitution.
# One optional pair of surrounding quotes is stripped. Unknown keys are rejected.
PGHOST=<service-id>.<project-id>.tsdb.cloud.timescale.com
PGPORT=<port>
PGDATABASE=tsdb
PGUSER=tsdbadmin
PGPASSWORD=<password>
# Optional; defaults to require.
PGSSLMODE=require
